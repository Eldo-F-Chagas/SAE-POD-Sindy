FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 5e-07;

boundaryField
{
    // Automatically handles the empty front/back constraint patch
    #includeEtc "caseDicts/setConstraintTypes"

    leftWall
    {
        type            nutkWallFunction;
        value           $internalField;
    }

    rightWall
    {
        type            nutkWallFunction;
        value           $internalField;
    }

    lowerWall
    {
        type            nutkWallFunction;
        value           $internalField;
    }

    atmosphere
    {
        type            zeroGradient;
    }
}

