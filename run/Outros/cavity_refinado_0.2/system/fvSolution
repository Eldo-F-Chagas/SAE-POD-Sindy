FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    // Densidade
    rho
    {
        solver          diagonal;
    }

    rhoFinal
    {
        $rho;
    }

    // Pressão (compressível: p)
    p
    {
        solver          GAMG;
        tolerance       1e-07;
        relTol          0.01;

        smoother        DICGaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 20;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    pFinal
    {
        $p;
        relTol          0.01;
    }

    // Velocidade (defina explicitamente U para poder usar $U)
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0.01;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    // Energia (h) — melhor que smoothSolver; o seu h parou em 1000 iterações
    h
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.01;
    }

    hFinal
    {
        $h;
        relTol          0;
    }

    // Turbulência (k-omega SST)
    k
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.01;
    }

    kFinal
    {
        $k;
        relTol          0;
    }

    omega
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.01;
    }

    omegaFinal
    {
        $omega;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor         yes;
    nOuterCorrectors          1;
    nCorrectors               2;
    nNonOrthogonalCorrectors  0;
}

