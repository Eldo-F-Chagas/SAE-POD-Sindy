FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // Second-order time discretisation, suitable for time-resolved LES
    default         CrankNicolson 0.9;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)         cellLimited Gauss linear 1;
}

divSchemes
{
    // VOF interface compression
    div(phi,alpha)  Gauss interfaceCompression vanLeer 1;

    // LES: 75% central + 25% linear-upwind
    div(rhoPhi,U)   Gauss LUST grad(U);

    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

