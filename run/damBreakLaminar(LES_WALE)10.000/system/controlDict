FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          incompressibleVoF;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1;

deltaT          0.0001;

// Write at the nominal temporal resolution: t = 0:0.0001:1 (10001 outputs).
// adjustableRunTime preserves fixed physical output times with adaptive time stepping.
writeControl    adjustableRunTime;
writeInterval   0.0001;

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

// LES: tighter Courant target for temporal accuracy
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.0001;

DebugSwitches
{
    MULES           1;
}

